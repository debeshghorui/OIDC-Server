{
    "name": "oidc-server",
    "version": "1.0.0",
    "description": "OIDC server built with Hono, better-auth, TypeScript, Drizzle ORM, and PostgreSQL",
    "type": "module",
    "main": "dist/server.js",
    "scripts": {
        "start": "node dist/server.js",
        "build": "tsc -p .",
        "dev": "tsc-watch --onSuccess \"node dist/server.js\"",
        "db:up": "docker compose up -d",
        "db:down": "docker compose down",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "studio": "drizzle-kit studio",
        "format": "prettier --write \"**/*.{js,ts,json}\"",
        "format:check": "prettier --check \"**/*.{js,ts,json}\"",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "check": "pnpm run format:check && pnpm run lint"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^25.5.0",
        "@types/pg": "^8.20.0",
        "drizzle-kit": "^0.31.10",
        "eslint": "^10.6.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.7.0",
        "prettier": "3.9.1",
        "tsc-watch": "^7.2.0",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.62.0"
    },
    "dependencies": {
        "@better-auth/drizzle-adapter": "^1.7.12",
        "@better-auth/oauth-provider": "^1.7.12",
        "@hono/node-server": "^2.1.5",
        "better-auth": "^1.7.12",
        "dotenv": "^17.3.1",
        "drizzle-orm": "^0.45.2",
        "hono": "^4.13.13",
        "pg": "^8.20.0",
        "zod": "^4.3.6"
    }
}
