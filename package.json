{
  "name": "oidc-workspace",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter oidc-server dev",
    "build:client": "pnpm --filter client build",
    "build:server": "pnpm --filter oidc-server build",
    "start:client": "pnpm --filter client start",
    "start:server": "pnpm --filter oidc-server start",
    "lint:client": "pnpm --filter client lint",
    "lint:server": "pnpm --filter oidc-server lint",
    "db:up": "pnpm --filter oidc-server db:up",
    "db:down": "pnpm --filter oidc-server db:down",
    "db:generate": "pnpm --filter oidc-server db:generate",
    "db:migrate": "pnpm --filter oidc-server db:migrate",
    "studio": "pnpm --filter oidc-server studio"
  }
}
